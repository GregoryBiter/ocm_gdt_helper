<div class="product-container">
    {# 1. Использование умного перевода (через фильтр или функцию, если зарегистрирована) #}
    <h1>{{ __("text_product_detail") }}</h1>

    {% if flash('success') %}
        <div class="alert alert-success">
            {{ flash('success') }}
        </div>
    {% endif %}

    {% if flash('error') %}
        <div class="alert alert-danger">
            {{ flash('error') }}
        </div>
    {% endif %}

    <div class="product-info">
        <h3>{{ product.name }}</h3>
        <p>Модель: {{ product.model }}</p>
        <p>Цена: {{ product.price|number_format(2) }}</p>
    </div>

    <div class="actions">
        {# 2. Генерация ссылок через хелпер route() #}
        <a href="{{ route('common/home') }}" class="btn btn-default">
            {{ __("button_back") }}
        </a>

        <form action="{{ route('checkout/cart/add') }}" method="post">
            <input type="hidden" name="product_id" value="{{ product.product_id }}">
            <button type="submit" class="btn btn-primary">
                {{ __("button_cart") }}
            </button>
        </form>
    </div>

    {# 3. Доступ к сессии напрямую (если требуется) #}
    {% if session('last_viewed_product') %}
        <div class="history">
            <small>ID последнего просмотренного товара: {{ session('last_viewed_product') }}</small>
        </div>
    {% endif %}
    
    {# 4. Работа с конфигом #}
    {% if config('config_customer_online') %}
        <div class="online-status">
            <span class="label label-success">Мы онлайн!</span>
        </div>
    {% endif %}
</div>
